# ── JARVIS — configuration serveur ──────────────────────────────
# Copiez ce fichier vers `.env` à la racine du projet, puis remplissez.

# Clé API Anthropic (https://platform.claude.com).
# SANS clé : JARVIS démarre en MODE DÉMO complet (réponses simulées, données
# d'exemple, coût zéro). AVEC clé : intelligence Claude réelle.
ANTHROPIC_API_KEY=

# Forcer le mode démo même avec une clé (JARVIS_DEMO=1)
JARVIS_DEMO=

# Port du serveur backend (le client Vite proxifie /api vers ce port)
PORT=3001

# Routeur de modèles — surchargez si besoin (IDs de modèles Claude)
JARVIS_MODEL_FAST=claude-haiku-4-5
JARVIS_MODEL_BALANCED=claude-sonnet-5
JARVIS_MODEL_DEEP=claude-opus-4-8

# Chemin du fichier de persistance (cerveau, mémoire, tâches…)
JARVIS_DATA_FILE=./data/jarvis.json

# ── Voix de JARVIS (synthèse neuronale) ─────────────────────────
# Par défaut : voix neuronale Microsoft Edge, gratuite et sans clé.
# Voix françaises : fr-FR-HenriNeural (masculine, posée — défaut),
# fr-FR-DeniseNeural, fr-FR-RemyMultilingualNeural, fr-FR-VivienneMultilingualNeural
JARVIS_VOICE=fr-FR-HenriNeural

# Option : ElevenLabs (encore plus naturel — elevenlabs.io, offre gratuite)
ELEVENLABS_API_KEY=
# Id de voix ElevenLabs (défaut : « Daniel », majordome britannique)
JARVIS_ELEVENLABS_VOICE=
